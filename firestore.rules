rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private per-user data (onboarding answers etc.)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // A friend may add THEMSELVES to your friends list (happens when they enter your code)
    match /users/{uid}/friends/{fid} {
      allow create: if request.auth != null && request.auth.uid == fid;
    }

    // Public profile: any signed-in user can read, only the owner can write
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Friend codes -> uid lookup
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Chats between two friends
    match /chats/{cid} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;

      match /messages/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        // the receiver may only mark a message as read
        allow update: if request.auth != null
          && resource.data.to == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      }
    }
  }
}
